{
  "name": "linkto",
  "version": "0.5.0",
  "description": "LinkTo 林可兔 — AI 原生邮件工作台",
  "main": "./out/main/index.js",
  "author": "LinKTo · OpenFlow",
  "private": true,
  "bin": {
    "linkto": "scripts/linkto.mjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder -mwl",
    "test:fly": "node --no-warnings --experimental-strip-types scripts/fly-selftest.mts && node --no-warnings --experimental-strip-types scripts/fly-relay-selftest.mts && npx esbuild scripts/fly-service-selftest.mts --bundle --platform=node --format=esm --outfile=out/fly-svc-test.mjs --log-level=warning && node out/fly-svc-test.mjs",
    "test:update": "node --no-warnings --experimental-strip-types scripts/update-selftest.mts",
    "test:vault": "node --no-warnings --experimental-strip-types scripts/vault-selftest.mts",
    "test:all": "npm run test:fly && npm run test:update && npm run test:vault",
    "linkto": "node scripts/linkto.mjs",
    "fly:reader-hash": "node --no-warnings --experimental-strip-types scripts/fly-reader-hash.mts"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "imapflow": "^2.2.6",
    "mailparser": "^3.9.36",
    "node-llama-cpp": "^3.22.1",
    "nodemailer": "^10.0.15",
    "pdfjs-dist": "4.10.38",
    "pinyin-pro": "3.29.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "overrides": {
    "simple-git": "4.0.2",
    "global-agent": "4.1.3"
  }
}
